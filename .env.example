# ══════════════════════════════════════════════════════
# Personal AI Assistant — Environment Configuration
# ══════════════════════════════════════════════════════
#
# 📌 For LOCAL development: Copy this file to .env and fill in values.
# 📌 For STREAMLIT CLOUD: Add these as secrets in your Cloud dashboard.
#
#     Streamlit Cloud → Your App → Settings → Secrets
#
# ══════════════════════════════════════════════════════

# ── Model Provider ────────────────────────────────────
# Options: mock | ollama | openai
MODEL_PROVIDER=mock

# ── Ollama (Local) ────────────────────────────────────
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b

# ── OpenAI ────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=INFO

# ── Memory ────────────────────────────────────────────
# MAX_CONTEXT_MESSAGES=10
# MEMORY_PATH=data/chat.db
