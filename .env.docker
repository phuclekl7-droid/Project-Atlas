# ═══════════════════════════════════════════════════════════
# Project Atlas — Docker Environment
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and customize:
#   cp .env.docker .env
#
# Các biến môi trường này được docker-compose tự động đọc
# và inject vào container khi chạy `docker compose up`.
# ═══════════════════════════════════════════════════════════

# ── Model Provider ────────────────────────────────────────
# Options: mock | ollama | openai
MODEL_PROVIDER=mock

# ── OpenAI ────────────────────────────────────────────────
# Lấy API key từ https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-your-key-here

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Memory ────────────────────────────────────────────────
MAX_CONTEXT_MESSAGES=10
MEMORY_PATH=/app/data/memory.db
